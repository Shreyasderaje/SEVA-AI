SEVA_ENV=development
DATABASE_URL=sqlite:///./seva.db
JWT_SECRET=replace-me
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
CLASSIFIER_WEIGHTS_PATH=../ml/models/image_classifier_v1.pt
SERVICE_RADIUS_KM=50
RATE_LIMIT_LOGIN=5/minute

# Optional: used by backend/scripts/create_admin.py.
# If SEVA_ADMIN_PASSWORD is unset, a password is generated and printed once.
# SEVA_ADMIN_EMAIL=admin@seva.example
# SEVA_ADMIN_PASSWORD=change-me-immediately
